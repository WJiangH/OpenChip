      "signals": {
        "valid": 1,
        "ready": 1,
        "x_data": 32,
        "w_data": 32,
        "keep": 4,
        "group_first": 1,
        "group_last": 1,
        "row": 12,
        "group_index": 12,
        "command_last": 1
      },
      "semantics": "command_last iff group_last and final descriptor row/group; forwarded to group_result.last"
    },
    "terminal": {
      "signals": {
        "valid": 1,
        "ready": 1,
        "tag": 32,
        "error_code": 3,
        "cycles": 32
      }
    },
    "dma_terminal": {
      "signals": {
        "done": 1,
        "error": 1,
        "error_code": 3
      }
    },
    "fault_event": {
      "signals": {
        "fault_valid": 1,
        "fault_reason": 3,
        "fault_addr": 32
      },
      "semantics": "sticky until common reset; no READY; earliest edge then lowest reason",
      "unknown_address": 0,
      "known_address": "aligned matching AR/AW address retained once offered or accepted"
    },
    "stop_issue": {
      "signals": {
        "stop_new_transactions": 1
      },
      "semantics": "sticky; preserve all previously offered VALID and their associated W/R/B work"
    },
    "cpu_clock_reset": {
      "signals": {
        "clk": 1,
        "cpu_local_rst_n": 1,
        "rst_n": 1
      },
      "semantics": "wrapper sticky fault metadata resets only by common rst_n; PicoRV32 core resets by cpu_local_rst_n; bridge unaffected by local reset"
    }
  },
