  "blocks": [
    {
      "id": "cpu",
      "disposition": "integrate",
      "purpose": "RV32IM PicoRV32 native"
    },
    {
      "id": "cpu_bridge",
      "disposition": "build",
      "purpose": "error-aware native to AXI"
    },
    {
      "id": "fabric",
      "disposition": "build",
      "purpose": "serialized dual-channel AXI routing / firewall"
    },
    {
      "id": "rom",
      "disposition": "build",
      "purpose": "64 KiB instruction ROM"
    },
    {
      "id": "sram",
      "disposition": "build",
      "purpose": "256 KiB on-chip simulation SRAM"
    },
    {
      "id": "extmem",
      "disposition": "model",
      "purpose": "16 MiB external AXI target; controller/PHY excluded"
    },
    {
      "id": "lite_bridge",
      "disposition": "build",
      "purpose": "AXI4 to four AXI4-Lite targets"
    },
    {
      "id": "sys",
      "disposition": "build",
      "purpose": "reset/counters/fatal/result"
    },
    {
      "id": "irq",
      "disposition": "build",
      "purpose": "level IRQ source/mask"
    },
    {
      "id": "uart",
      "disposition": "build",
      "purpose": "TX serial only"
    },
    {
      "id": "npu_csr",
      "disposition": "build",
      "purpose": "single command shadow registers"
    },
    {
      "id": "npu_ctl",
      "disposition": "build",
      "purpose": "command / error controller"
    },
    {
      "id": "npu_dma",
      "disposition": "build",
      "purpose": "read and write DMA"
    },
    {
      "id": "npu_local",
      "disposition": "build",
      "purpose": "activation and weight/write buffers"
    },
    {
      "id": "npu_dot",
      "disposition": "build",
      "purpose": "four signed-byte products, grouped INT32 sum"
    },
    {
      "id": "caliptra",
      "disposition": "integrate-S1-only",
      "purpose": "passive core; separate unreleased S1 port supplement"
    }
  ],
